# App
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRY=8h
AGENT_TOKEN_EXPIRY=1h

# MongoDB (Azure AD LDAP — production)
# For dev, use: mongodb://svc_configguard:devpassword@mongodb:27017/configguard
MONGO_URI=mongodb://svc_configguard:devpassword@mongodb:27017/configguard
MONGO_LDAP_SERVERS=ldaps://your-ad-server.corp.com:636
MONGO_LDAP_BIND_DN=CN=svc_configguard,OU=ServiceAccounts,DC=corp,DC=com
MONGO_LDAP_BIND_PASSWORD=

# Redis (BullMQ ingestion queue)
REDIS_URL=redis://redis:6379

# TLS (nginx — corporate CA-signed cert, mounted as Docker volume in prod)
# Leave empty in dev (self-signed cert used automatically)
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Corporate Monitoring Tool
MONITOR_TOOL_API_URL=http://your-monitor-tool.corp.com/api
MONITOR_TOOL_API_KEY=
MONITOR_TOOL_DEFAULT_CARD_ID=00000
# Absolute path to the error_signal_sending script (mounted into backend container)
MONITOR_SIGNAL_SCRIPT=/opt/configguard/scripts/send_signal.sh

# Open Webhook API
WEBHOOK_SECRET=change_me_to_a_long_random_webhook_secret
